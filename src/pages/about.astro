---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaLink from '@/components/ui/CtaLink.astro';
import Press from '@/components/layout/Press.astro';
import studioImage from '@/assets/studio.jpg';
import { site } from '@/config/site';
import { PROJECT_TYPES, SERVICES } from '@/config/taxonomy';
import { PROCESS_BY_PHASE } from '@/config/studio';

// Tên lấy từ phần ghi công trong hai bài VnExpress về công trình của studio —
// không phải suy đoán. Vai trò cụ thể thì cần studio xác nhận.
const team = [
  { name: 'Đỗ Đình Mạnh', role: 'Kiến trúc sư' },
  { name: 'Nguyễn Thái Hoàng', role: 'Kiến trúc sư' },
];
---

<BaseLayout
  title="Về studio"
  description={`${site.legalName} — văn phòng kiến trúc tại ${site.city}. Thiết kế nhà ở, thương mại và cải tạo.`}
>
  <section class="px-5 pt-32 pb-14 md:px-10 md:pt-44 md:pb-20">
    <h1 class="max-w-[24ch] text-display leading-[0.94] font-light tracking-[-0.02em]">
      Ánh sáng, thông gió, vật liệu địa phương
    </h1>
    <p class="mt-6 text-lead text-ink-soft">
      {site.city} — từ năm {site.foundedYear}
    </p>
  </section>

  <figure
    data-skeleton
    class="relative aspect-[3/2] overflow-hidden bg-paper-deep md:aspect-[21/9]"
  >
    <div class="absolute inset-x-0 -top-[8%] h-[116%]">
      <Picture
        src={studioImage}
        alt={`Văn phòng làm việc của ${site.name}`}
        formats={['avif', 'webp']}
        fallbackFormat="jpeg"
        widths={[480, 640, 768, 1280, 1800, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        data-parallax="10"
        pictureAttributes={{ class: 'block h-full w-full' }}
        class="h-full w-full object-cover"
      />
    </div>
  </figure>

  <!--
    Hai cột 4 dòng, cao bằng nhau. Trước đây band này ba cột với Hạng mục 8 mục ở
    giữa — cao gấp đôi hai cột kia, mà gap-px bg-line kẻ vạch suốt chiều cao nên phần
    trống của hai cột ngắn đọc ra như lỗi layout chứ không phải khoảng thở.
  -->
  <section class="grid gap-px bg-line md:grid-cols-2">
    <div class="bg-paper px-5 py-14 md:px-10 md:py-20">
      <p class="label">Dịch vụ</p>
      <ul class="mt-6 space-y-3">
        {
          SERVICES.map((s) => (
            <li class="text-lead font-light">{s.label}</li>
          ))
        }
      </ul>
    </div>

    <!--
      Bốn giai đoạn tổng, dẫn xuống bản 8 bước ở trang chủ.

      Cả hai cùng đọc từ PROCESS trong config/studio.ts nên không thể lệch nhau: ở đây
      là bản đồ tổng cho người đang tìm hiểu studio, trang chủ là bản chi tiết cho người
      đang cân nhắc thuê. Dải số ("01–02") cho biết mỗi giai đoạn gồm mấy bước.
    -->
    <div class="bg-paper px-5 py-14 md:px-10 md:py-20">
      <p class="label">Quy trình</p>
      <ol class="mt-6 space-y-3">
        {
          PROCESS_BY_PHASE.map((phase) => (
            <li class="flex gap-5">
              <span class="label pt-1.5 tabular-nums">{phase.range}</span>
              <span class="text-lead font-light">{phase.label}</span>
            </li>
          ))
        }
      </ol>

      <a href="/#quy-trinh" class="link-underline mt-8 inline-block text-sm">
        Chi tiết 8 bước
      </a>
    </div>
  </section>

  <!--
    Hạng mục tách ra thành một hàng riêng: đây là 8 đường dẫn điều hướng, khác thể
    loại với hai danh sách tuyên bố ở trên. Trải ngang cũng cho mỗi hạng mục vùng bấm
    rộng hơn nhiều so với khi bị nén trong một phần ba chiều rộng.
  -->
  <section class="border-t border-line px-5 py-14 md:px-10 md:py-20">
    <p class="label">Hạng mục</p>
    <ul class="mt-6 flex flex-wrap gap-x-10 gap-y-3">
      {
        PROJECT_TYPES.map((t) => (
          <li>
            <a href={`/projects?type=${t.slug}`} class="link-underline text-lead font-light">
              {t.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Press label="Truyền thông" />

  <section class="px-5 py-16 md:px-10 md:py-24">
    <p class="label">Nhóm</p>
    <ul class="mt-6 grid gap-8 sm:grid-cols-3">
      {
        team.map((member) => (
          <li>
            <p class="text-lead font-normal tracking-tight">{member.name}</p>
            <p class="label mt-1.5">{member.role}</p>
          </li>
        ))
      }
    </ul>

    <CtaLink href="/contact" variant="dark-outline" class="mt-14">Liên hệ studio</CtaLink>
  </section>
</BaseLayout>
