---
import { render } from 'astro:content';
import { getImage, Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BackLink from '@/components/layout/BackLink.astro';
import Band from '@/components/section/Band.astro';
import { ROUTES, projectPath, typePath } from '@/config/routes';
import { coverAlt, getProjects, type Project } from '@/lib/projects';
import SpecTable from '@/components/project/SpecTable.astro';
import Gallery from '@/components/project/Gallery.astro';
import { site } from '@/config/site';
import { statusLabel, typeLabel } from '@/config/taxonomy';

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project, i) => ({
    params: { slug: project.id },
    // Truyền prev/next qua props: tính một lần lúc build thay vì mỗi trang tự
    // load lại toàn bộ collection.
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: Project;
  prev: Project | null;
  next: Project | null;
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const description =
  d.excerpt ?? `${d.title} — ${typeLabel(d.type).toLowerCase()} do ${site.name} thiết kế.`;

// Có chữ thật (tóm tắt hoặc nội dung MDX) thì mới dựng cột chữ.
const hasText = Boolean(d.excerpt) || (project.body ?? '').trim().length > 0;

const facts = [
  { label: 'Loại hình', value: typeLabel(d.type), href: typePath(d.type) },
  ...(d.location ? [{ label: 'Địa điểm', value: d.location, href: undefined }] : []),
  ...(d.year ? [{ label: 'Năm', value: String(d.year), href: undefined }] : []),
  { label: 'Trạng thái', value: statusLabel(d.status), href: undefined },
];

// Ảnh chia sẻ phải là bản cắt 1200×630 riêng, không dùng thẳng d.cover.src:
// ảnh gốc nặng tới ~1,9 MB và sai tỉ lệ nên Facebook/Zalo tự cắt lung tung.
const ogImage = await getImage({
  src: d.cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 78,
});
---

<BaseLayout title={d.title} description={description} ogImage={ogImage.src}>
  <article>
    <!--
      Đầu trang là chữ mực trên nền giấy, cùng khuôn với mọi trang con — không còn hero
      tối cao 86svh với chữ trắng đè lên ảnh. Ba thông số chính nằm ngay cạnh tên dự án:
      khách biết đây là loại công trình gì trước khi xem ảnh.
    -->
    <header
      class="px-5 pt-[calc(var(--header-h)+1.5rem)] pb-8 md:px-10 md:pt-[calc(var(--header-h)+2.5rem)] md:pb-12"
    >
      <BackLink href={ROUTES.projects} label="Dự án" class="label" />

      <div class="mt-10 grid gap-8 md:mt-16 lg:grid-cols-12 lg:items-end">
        <h1
          class="text-display leading-[0.98] font-light tracking-[-0.025em] text-balance lg:col-span-7"
        >
          {d.title}
        </h1>

        <dl class="flex flex-wrap gap-x-10 gap-y-4 lg:col-span-5 lg:justify-end">
          {
            facts.map((fact) => (
              <div>
                <dt class="label">{fact.label}</dt>
                <dd class="mt-1.5 text-sm">
                  {fact.href ? (
                    <a href={fact.href} class="link-underline">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <!-- LCP của trang: AVIF trước, WebP sau, JPEG chốt hạ. -->
    <figure data-skeleton class="relative aspect-[3/2] overflow-hidden bg-paper-deep md:aspect-[21/9]">
      <div class="absolute inset-x-0 -top-[7%] h-[114%]">
        <Picture
          src={d.cover}
          alt={coverAlt(project)}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[640, 1280, 1800, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          data-parallax
          pictureAttributes={{ class: 'block h-full w-full' }}
          class="h-full w-full object-cover"
        />
      </div>
    </figure>

    <!-- Ảnh trước, chữ sau: người xem hồ sơ kiến trúc quyết định bằng ảnh. -->
    <section class="pt-6 pb-16 md:pt-8 md:pb-24">
      <Gallery gallery={d.gallery} title={d.title} />
    </section>

    <Band label="Thông tin">
      <div class="grid gap-12 lg:grid-cols-9 lg:gap-10">
        {
          hasText && (
            <div class="lg:col-span-5">
              {d.excerpt && (
                <p class="text-title leading-[1.2] font-light tracking-tight">{d.excerpt}</p>
              )}

              <div class="mt-8 max-w-[62ch] space-y-5 leading-[1.7] text-ink-soft [&_h2]:pt-6 [&_h2]:text-title [&_h2]:font-light [&_h2]:tracking-tight [&_h2]:text-ink [&_strong]:font-medium [&_strong]:text-ink">
                <Content />
              </div>
            </div>
          )
        }

        <div class:list={[hasText ? 'lg:col-span-4' : 'lg:col-span-5']}>
          <SpecTable project={project} />
        </div>
      </div>
    </Band>

    <!-- Điều hướng dự án kế tiếp: giữ người xem trong luồng xem hồ sơ. -->
    <nav class="grid border-t border-line md:grid-cols-2" aria-label="Điều hướng giữa các dự án">
      {
        prev ? (
          <a
            href={projectPath(prev.id)}
            class="group border-b border-line px-5 py-10 md:border-r md:border-b-0 md:px-10 md:py-14"
          >
            <p class="label">← Dự án trước</p>
            <p class="mt-3 text-title leading-tight font-light tracking-tight">
              <span class="link-underline">{prev.data.title}</span>
            </p>
          </a>
        ) : (
          <div class="hidden md:block" />
        )
      }

      {
        next ? (
          <a href={projectPath(next.id)} class="group px-5 py-10 md:px-10 md:py-14 md:text-right">
            <p class="label">Dự án tiếp theo →</p>
            <p class="mt-3 text-title leading-tight font-light tracking-tight">
              <span class="link-underline">{next.data.title}</span>
            </p>
          </a>
        ) : (
          <div class="hidden md:block" />
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .group:hover .link-underline::after {
    transform: scaleX(1);
  }
</style>
