---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkWall from '@/components/project/WorkWall.astro';
import Press from '@/components/layout/Press.astro';
import Hero from '@/components/layout/Hero.astro';
import { site } from '@/config/site';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

// Lưới 6 cột: 35 ô dự án + 1 ô dẫn sang danh mục đầy đủ = 6 hàng tròn trịa.
// Giới hạn để trang chủ không nhân bản y nguyên /projects (trùng nội dung, hại SEO).
const WALL_LIMIT = 35;
const wall = all.slice(0, WALL_LIMIT);
const hasMore = all.length > wall.length;
---

<BaseLayout>
  <!--
    Hero: tên studio, một dòng định vị, một lối xuống. Không hơn.

    Chiều cao thấp hơn một màn hình đầy để lưới dự án hé lên ở mép dưới — vừa nói
    cho người xem biết còn nội dung bên dưới, vừa làm ảnh hero đọc ra kích thước
    thật thay vì bị phóng full màn.
  -->
  <section
    class="relative flex h-[74svh] min-h-[26rem] flex-col overflow-hidden md:h-[88svh]"
    data-hero
  >
    <div class="absolute inset-x-0 -top-[7%] h-[114%]">
      <Hero alt={`Công trình tiêu biểu của ${site.name}`} />
    </div>

    <div
      class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/10 to-black/65"
      aria-hidden="true"
    >
    </div>

    <div class="relative mt-auto px-5 pb-12 text-white md:px-10 md:pb-14">
      <h1 class="text-display leading-[0.9] font-light tracking-[-0.02em]">{site.name}</h1>

      <p class="mt-4 max-w-[34ch] text-[1.125rem] leading-snug text-white/90 md:text-[1.5rem]">
        {site.positioning} — {site.city}
      </p>

      <a
        href="#work"
        class="mt-8 inline-flex items-center gap-2 text-[0.6875rem] tracking-[0.18em] uppercase"
      >
        {all.length} dự án
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <!--
    Toàn bộ công trình ngay sau hero, không chèn tuyên ngôn hay dịch vụ vào giữa.
    Ảnh trả lời câu "studio này làm kiến trúc gì" nhanh hơn mọi đoạn văn.
  -->
  <section id="work" class="scroll-mt-0">
    <WorkWall
      projects={wall}
      eagerCount={4}
      moreHref={hasMore ? '/projects' : undefined}
      moreLabel={hasMore ? `Tất cả ${all.length} dự án` : undefined}
    />
  </section>

  <Press />

  <!-- Một câu về cách làm việc, kèm hai lối đi. Phần chữ dài để ở trang Về studio. -->
  <section class="px-5 py-20 md:px-10 md:py-28">
    <p class="max-w-[30ch] text-title leading-[1.12] font-light tracking-tight" data-reveal>
      Ánh sáng, thông gió, vật liệu địa phương.
    </p>

    <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
      <a href="/about" class="link-underline text-sm">Về studio</a>
      <a href="/contact" class="link-underline text-sm">Liên hệ</a>
    </div>
  </section>
</BaseLayout>
