---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Intro from '@/components/home/Intro.astro';
import TypeFilter from '@/components/project/TypeFilter.astro';
import WorkWall from '@/components/project/WorkWall.astro';
import Band from '@/components/section/Band.astro';
import Press from '@/components/section/Press.astro';
import ClosingCta from '@/components/section/ClosingCta.astro';
import { ROUTES } from '@/config/routes';
import { PROCESS, PROCESS_BY_PHASE } from '@/config/services';
import { countByType, getProjects } from '@/lib/projects';

/*
  Trang chủ là nơi XEM NHÀ: các ô công trình chiếm màn hình đầu.
    1. Làm dịch vụ gì?    → Intro: một hàng mảnh 4 dịch vụ sát header.
    2. Làm công trình gì?  → Thanh loại hình + lưới ô nhà (ô đầu lớn 2×2).
    3. Làm thế nào, ai nói? → Quy trình 4 giai đoạn, báo chí, lời mời.
*/
const all = await getProjects();

// Trần để trang chủ không phình vô hạn. Ô đầu chiếm 4 ô nên 3 + 21 = 24 ô, vừa khít
// lưới 4 cột; không dùng ô chốt ở đây vì cuối trang đã có lời mời liên hệ.
const WALL_LIMIT = 21;
const wall = all.slice(0, WALL_LIMIT);
const hasMore = all.length > wall.length;

const ctaProject = all.find((p) => p.data.featured) ?? all[0];
---

<BaseLayout showFooterContact={false}>
  <Intro />

  <section id="du-an" aria-label="Dự án" class="pb-16 md:pb-24">
    <TypeFilter types={countByType(wall)} total={wall.length} class="md:py-4" />
    <div class="h-4 md:hidden"></div>
    <WorkWall projects={wall} feature />

    {
      hasMore && (
        <a href={ROUTES.projects} class="link-underline mx-5 mt-10 inline-block text-sm md:mx-10">
          Tất cả {all.length} dự án →
        </a>
      )
    }
  </section>

  <Band label="Quy trình">
    <ol class="grid grid-cols-2 gap-px bg-line lg:grid-cols-4">
      {
        PROCESS_BY_PHASE.map((phase) => (
          <li class="bg-paper py-5 odd:pr-4 even:pl-4 lg:px-5 lg:first:pl-0">
            <span class="label tabular-nums">{phase.range}</span>
            <p class="mt-3 text-title leading-tight font-light tracking-tight">{phase.label}</p>
          </li>
        ))
      }
    </ol>

    <a href={`${ROUTES.services}#quy-trinh`} class="link-underline mt-8 inline-block text-sm">
      {PROCESS.length} bước chi tiết →
    </a>
  </Band>

  <Press />
  <ClosingCta image={ctaProject?.data.cover} />
</BaseLayout>
