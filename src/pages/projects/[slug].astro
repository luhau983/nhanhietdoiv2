---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage, Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BackLink from '@/components/layout/BackLink.astro';
import SpecTable from '@/components/project/SpecTable.astro';
import Gallery from '@/components/project/Gallery.astro';
import { typeLabel } from '@/config/taxonomy';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
  );

  return projects.map((project, i) => ({
    params: { slug: project.id },
    // Truyền prev/next qua props: tính một lần lúc build thay vì mỗi trang tự
    // load lại toàn bộ collection.
    props: {
      project,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'> | null;
  next: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// Ảnh chia sẻ phải là bản cắt 1200×630 riêng, không dùng thẳng d.cover.src:
// ảnh gốc nặng tới ~1,9 MB và sai tỉ lệ nên Facebook/Zalo tự cắt lung tung.
const ogImage = await getImage({
  src: d.cover,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
  quality: 78,
});
---

<BaseLayout title={d.title} description={d.excerpt} ogImage={ogImage.src}>
  <article>
    <header class="relative h-[86svh] min-h-[30rem] overflow-hidden">
      <div class="absolute inset-x-0 -top-[6%] h-[112%]">
        <!--
          LCP của trang này. AVIF trước, WebP sau, JPEG chốt hạ — ảnh hero full-bleed
          là file nặng nhất trang nên chênh lệch định dạng ở đây đáng giá nhất.
          Thêm bậc 480/640 cho điện thoại: trước đây bậc nhỏ nhất là 768 nên máy màn
          hẹp vẫn phải tải ảnh rộng hơn nhu cầu.
        -->
        <Picture
          src={d.cover}
          alt={`${d.title} — ${typeLabel(d.type)} tại ${d.location}`}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[480, 640, 768, 1280, 1800, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          data-parallax="10"
          pictureAttributes={{ class: 'block h-full w-full' }}
          class="h-full w-full object-cover"
        />
      </div>

      <div
        class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/5 to-black/60"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative flex h-full flex-col justify-end px-5 pt-20 pb-12 text-white md:px-10 md:pt-24 md:pb-16"
      >
        <!--
          pt-20/pt-24 để nút nằm dưới thanh header (cao 65px ở mobile, 69px ở desktop)
          chứ không chui vào sau nó; mb-auto đẩy phần tên dự án về lại đáy hero.

          text-shadow: từ khi header có nền giấy cố định thì lớp scrim tối ở đỉnh hero
          không còn, mà đây là chữ trắng nằm trên vùng ảnh chưa bị gradient của hero
          làm tối bao nhiêu — gặp ảnh trời sáng là chìm. Bóng đổ rẻ hơn việc thêm một
          lớp phủ nữa chỉ để đỡ một dòng chữ.
        -->
        <BackLink
          href="/projects"
          class="mb-auto text-[0.6875rem] tracking-[0.18em] uppercase [text-shadow:0_1px_4px_rgb(0_0_0/0.55)]"
        />

        <div>
          <p class="text-[0.6875rem] tracking-[0.18em] text-white/70 uppercase">
            {typeLabel(d.type)} — {d.location} — {d.year}
          </p>
          <h1 class="mt-4 max-w-[24ch] text-display leading-[0.92] font-light tracking-[-0.02em]">
            {d.title}
          </h1>
        </div>
      </div>
    </header>

    <!-- Tóm tắt + thông số đặt ngay dưới hero: người xem biết đây là gì trước khi cuộn ảnh. -->
    <section class="px-5 py-20 md:px-10 md:py-28">
      <div class="grid gap-14 md:grid-cols-12">
        <div class="md:col-span-6">
          <p class="text-title leading-[1.18] font-light tracking-tight" data-reveal>
            {d.excerpt}
          </p>
        </div>

        <div class="md:col-span-5 md:col-start-8" data-reveal style="--reveal-delay: 120ms">
          <SpecTable project={project} />
        </div>
      </div>
    </section>

    <!--
      Nội dung dài viết trong MDX: prose hẹp để dòng chữ không quá 70 ký tự.

      Đặt trong cùng lưới 12 cột và cùng cột với đoạn tóm tắt phía trên thay vì
      mx-auto. Trước đây khối này canh giữa trong khi tiêu đề, tóm tắt canh trái còn
      bảng thông số canh phải — bốn mốc canh lề khác nhau trên một trang, mắt không
      có chỗ bám. Giờ cả trang chung một trục trái.
    -->
    <section class="px-5 md:px-10">
      <div class="grid md:grid-cols-12">
        <div
          class="max-w-[62ch] space-y-6 text-lead leading-[1.7] text-ink-soft md:col-span-6 [&_h2]:pt-8 [&_h2]:text-title [&_h2]:font-light [&_h2]:tracking-tight [&_h2]:text-ink [&_strong]:font-medium [&_strong]:text-ink"
          data-reveal
        >
          <Content />
        </div>
      </div>
    </section>

    <section class="pt-20 pb-24 md:pt-32 md:pb-36">
      <Gallery gallery={d.gallery} title={d.title} />
    </section>

    <!-- Điều hướng dự án kế tiếp: giữ người xem trong luồng xem hồ sơ. -->
    <nav
      class="grid border-t border-line md:grid-cols-2"
      aria-label="Điều hướng giữa các dự án"
    >
      {
        prev ? (
          <a href={`/projects/${prev.id}`} class="group border-b border-line px-5 py-10 md:border-r md:border-b-0 md:px-10 md:py-14">
            <p class="label">Dự án trước</p>
            <p class="mt-3 text-lead font-light tracking-tight transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:-translate-x-1.5">
              {prev.data.title}
            </p>
          </a>
        ) : (
          <div class="hidden md:block" />
        )
      }

      {
        next ? (
          <a href={`/projects/${next.id}`} class="group px-5 py-10 md:px-10 md:py-14 md:text-right">
            <p class="label">Dự án tiếp theo</p>
            <p class="mt-3 text-lead font-light tracking-tight transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:translate-x-1.5">
              {next.data.title}
            </p>
          </a>
        ) : (
          <div class="hidden md:block" />
        )
      }
    </nav>
  </article>
</BaseLayout>
