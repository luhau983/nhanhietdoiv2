---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import WorkWall from '@/components/project/WorkWall.astro';
import { PROJECT_TYPES } from '@/config/taxonomy';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

// Chỉ hiện bộ lọc cho hạng mục thực sự có dự án — nút lọc ra 0 kết quả là lỗi UX.
const usedTypes = new Set(projects.map((p) => p.data.type));
const filters = PROJECT_TYPES.filter((t) => usedTypes.has(t.slug));

const countByType = (slug: string) => projects.filter((p) => p.data.type === slug).length;
---

<BaseLayout
  title="Dự án"
  description="Danh mục dự án: nhà phố, biệt thự, căn hộ, khách sạn — resort, cafe — nhà hàng, showroom và nội thất do Nhà Nhiệt Đới thiết kế và thi công."
>
  <!-- Thanh lọc là toàn bộ phần chữ của trang này. Còn lại để ảnh nói. -->
  <section class="px-5 pt-28 pb-6 md:px-10 md:pt-36 md:pb-8">
    <div class="flex flex-wrap items-center gap-2" data-filter-bar>
      <button
        type="button"
        class="inline-flex min-h-11 items-center border border-line px-4 text-[0.6875rem] tracking-[0.16em] text-ink-soft uppercase transition-colors duration-300 hover:border-ink hover:text-ink data-[active]:border-ink data-[active]:bg-ink data-[active]:text-paper"
        data-filter="all"
        data-active
      >
        Tất cả {projects.length}
      </button>
      {
        filters.map((t) => (
          <button
            type="button"
            class="inline-flex min-h-11 items-center border border-line px-4 text-[0.6875rem] tracking-[0.16em] text-ink-soft uppercase transition-colors duration-300 hover:border-ink hover:text-ink data-[active]:border-ink data-[active]:bg-ink data-[active]:text-paper"
            data-filter={t.slug}
          >
            {t.label} {countByType(t.slug)}
          </button>
        ))
      }
    </div>
  </section>

  <WorkWall projects={projects} eagerCount={4} />

  <p class="label hidden px-5 py-16 md:px-10" data-empty>Chưa có dự án trong hạng mục này.</p>
</BaseLayout>

<script>
  function initFilter() {
    const bar = document.querySelector<HTMLElement>('[data-filter-bar]');
    const wall = document.querySelector<HTMLElement>('[data-work-wall]');
    if (!bar || !wall) return;

    // Script của trang cũng bị hoist xuống sau khi ClientRouter (ở <head>) đã bắn
    // astro:page-load, nên phải gọi thẳng một lần lúc module chạy. Cờ trên chính
    // thanh lọc chặn gắn listener hai lần; sau khi điều hướng thì DOM mới nên cờ
    // mất và tự khởi tạo lại.
    if (bar.dataset.ready) return;
    bar.dataset.ready = 'true';

    // TS không giữ narrowing của querySelector khi biến được dùng trong function
    // lồng bên dưới, nên gán lại vào biến đã chắc chắn non-null.
    const wallEl = wall;

    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(wallEl.querySelectorAll<HTMLElement>('[data-project-type]'));
    const empty = document.querySelector<HTMLElement>('[data-empty]');

    function apply(type: string, pushUrl: boolean) {
      let visible = 0;

      items.forEach((item) => {
        const match = type === 'all' || item.dataset.projectType === type;
        item.hidden = !match;
        if (match) visible += 1;
      });

      buttons.forEach((btn) => {
        if (btn.dataset.filter === type) btn.setAttribute('data-active', '');
        else btn.removeAttribute('data-active');
      });

      empty?.classList.toggle('hidden', visible > 0);

      if (!pushUrl) return;
      // Cập nhật URL để chia sẻ được link đã lọc, nhưng không tạo entry history mới
      // cho mỗi lần bấm — nút back nên đưa người dùng về trang trước, không phải
      // lùi qua từng bộ lọc.
      const url = new URL(window.location.href);
      if (type === 'all') url.searchParams.delete('type');
      else url.searchParams.set('type', type);
      window.history.replaceState({}, '', url);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => apply(btn.dataset.filter ?? 'all', true));
    });

    // Tôn trọng ?type= khi vào trang từ link ngoài.
    const initial = new URL(window.location.href).searchParams.get('type');
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);
  }

  document.addEventListener('astro:page-load', initFilter);
  initFilter();
</script>
