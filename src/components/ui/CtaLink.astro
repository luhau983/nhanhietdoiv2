---
interface Props {
  href: string;
  /**
   * light* dùng khi nút nằm trên ảnh tối (hero), dark* dùng trên nền giấy.
   * Tách biến thể theo nền thay vì tự động: nền ảnh thay đổi theo từng trang,
   * đoán sai contrast là lỗi tiếp cận, không phải lỗi thẩm mỹ.
   */
  variant?: 'light-solid' | 'light-outline' | 'dark-solid' | 'dark-outline';
  class?: string;
}

const { href, variant = 'dark-solid', class: className = '' } = Astro.props;

const VARIANTS: Record<NonNullable<Props['variant']>, string> = {
  'light-solid': 'bg-paper text-ink hover:bg-white',
  'light-outline': 'border border-white/70 text-white hover:bg-white hover:text-ink',
  'dark-solid': 'bg-ink text-paper hover:bg-ink-soft',
  'dark-outline': 'border border-ink text-ink hover:bg-ink hover:text-paper',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-3 px-7 py-4 text-sm tracking-wide transition-colors duration-500',
    VARIANTS[variant],
    className,
  ]}
>
  <slot />
  <span aria-hidden="true" class="translate-y-px">→</span>
</a>
