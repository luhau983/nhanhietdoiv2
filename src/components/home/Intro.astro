---
import { servicePath } from '@/config/routes';
import { SERVICES } from '@/config/services';
import { site } from '@/config/site';

/*
  Dải mở đầu trang chủ: bốn dịch vụ thành MỘT hàng mảnh ở mọi khổ màn.

  Khách chủ yếu xem bằng điện thoại và chỉ lướt vài giây, nên màn đầu 375×812 phải
  chứa đủ: làm dịch vụ gì (hàng này, 48px), làm loại nhà gì (thanh loại hình ngay
  dưới), và nhà trông ra sao (ô công trình). Vì vậy trên điện thoại dùng nhãn ngắn
  (`short`) và ẩn dòng định danh — logo ở header đã nói tên studio.

  Cố ý KHÔNG có ảnh hero: thứ chiếm màn hình đầu phải là các ô công trình.
*/
---

<section class="pt-[var(--header-h)]" aria-label="Giới thiệu">
  <h1 class="label px-5 py-4 max-md:sr-only md:px-10 md:py-5">
    {site.legalName} <span class="text-muted/70">— {site.city}, từ {site.foundedYear}</span>
  </h1>

  <nav aria-label="Dịch vụ" class="border-b border-line md:border-t">
    <ol class="grid grid-cols-4 gap-px bg-line">
      {
        SERVICES.map((service) => (
          <li class="bg-paper">
            <a
              href={servicePath(service.slug)}
              aria-label={service.label}
              class="group flex h-full min-h-12 items-center justify-center gap-3 px-1 text-center transition-colors duration-300 hover:bg-paper-deep md:justify-start md:px-10 md:py-5 md:text-left"
            >
              <span class="label tabular-nums max-md:hidden">{service.num}</span>
              <span class="text-[0.8125rem] leading-tight md:hidden">{service.short}</span>
              <span class="text-lead leading-tight max-md:hidden">{service.label}</span>
              <span
                class="ml-auto text-muted transition-[transform,color] duration-500 ease-[var(--ease-hover)] group-hover:translate-x-1 group-hover:text-ink max-lg:hidden"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>
