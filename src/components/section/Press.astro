---
import Band from '@/components/section/Band.astro';
import { press } from '@/config/press';
---

<!-- Bằng chứng bên thứ ba: báo nào, bài gì, ngày nào — không thêm chữ. -->
{
  press.length > 0 && (
    <Band label="Báo chí">
      <ul class="border-t border-line">
        {press.map((item) => (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group grid gap-1.5 border-b border-line py-5 sm:grid-cols-[7rem_1fr_auto] sm:items-baseline sm:gap-8"
            >
              <span class="label">{item.outlet}</span>

              <span class="text-lead font-light">
                {item.title}
                <span
                  class="ml-2 inline-block text-muted transition-transform duration-500 ease-[var(--ease-hover)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </span>

              <span class="label shrink-0">{item.dateLabel}</span>
            </a>
          </li>
        ))}
      </ul>
    </Band>
  )
}
