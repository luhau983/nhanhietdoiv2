---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { typeLabel } from '@/config/taxonomy';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** Số ô tải eager — chỉ nên bằng số ô thực sự nằm trong màn hình đầu. */
  eagerCount?: number;
  /** Ô chữ chốt cuối lưới: vừa là điểm dừng, vừa lấp ô lẻ của hàng cuối. */
  moreHref?: string;
  moreLabel?: string;
}

/*
  Slot "lead": ô mở đầu tràn hết một hàng lưới, dùng cho hero trang chủ.

  Đặt hero vào trong chính <ul> chứ không để thành section riêng phía trên: hero
  rời cao 74svh nuốt 74% màn điện thoại, vào trang chỉ thấy hai ô dự án ló ở mép
  dưới. Thành ô đầu của lưới thì hero và lưới là một khối liền, màn đầu ở 375×812
  hiện một ảnh lớn + 5 dự án.

  col-span-full nên nó luôn chiếm trọn một hàng ở mọi breakpoint, giữ nguyên phép
  chia hết của lưới: 2 cột → 2+11+1=14, 3 → 15, 4 → 16, 6 → 18, không hàng nào lẻ ô.
*/
const hasLead = Astro.slots.has('lead');

// Mặc định 6 = đúng một hàng đầy ở breakpoint rộng nhất (lg:grid-cols-6). Để 4 như
// trước thì hai ô cuối của hàng đầu vẫn nằm trong màn hình đầu mà lại tải lazy.
const { projects, eagerCount = 6, moreHref, moreLabel } = Astro.props;

/*
  sizes phải bám đúng số cột của lưới, nếu không trình duyệt chọn nhầm bậc srcset:
  lưới là 2 / sm:3 / md:4 / lg:6 cột, tương ứng 50 / 33.33 / 25 / 16.67vw. Khai báo
  cũ (25vw ở lg, 33vw ở md) lệch nguyên một bậc nên mỗi ô tải ảnh to gấp rưỡi mức cần.

  Breakpoint viết theo đúng mốc Tailwind: sm=640, md=768, lg=1024.
*/
const TILE_SIZES =
  '(min-width: 1024px) 16.67vw, (min-width: 768px) 25vw, (min-width: 640px) 33.33vw, 50vw';

// Ô vuông cạnh ~240px ở màn 1440 và ~430px ở màn 2560; nhân DPR 2 là ~860px.
const TILE_WIDTHS = [240, 360, 480, 640, 960];
---

<!--
  Lưới dày tràn viền: toàn bộ công trình hiện ra cùng lúc, người xem nắm được
  khối lượng và thể loại việc studio làm mà không phải đọc một dòng nào.

  Cải tiến so với các trang cùng thể loại: lưới của họ hoàn toàn không nhãn nên
  không phân biệt được nhà ở với resort hay cao tầng. Ở đây tên và hạng mục hiện
  khi hover, và hiện thường trực trên mobile vì cảm ứng không có hover.
-->
<ul
  class="grid grid-cols-2 gap-px bg-line sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6"
  data-work-wall
>
  {
    hasLead && (
      <li class="col-span-full">
        <slot name="lead" />
      </li>
    )
  }

  {
    projects.map((project, i) => (
      <li data-project-type={project.data.type}>
        <a
          href={`/projects/${project.id}`}
          class="group relative block aspect-square overflow-hidden bg-paper-deep"
        >
          <!--
            WebP một định dạng, KHÔNG dùng Picture + AVIF ở đây.

            Đã thử và đo: bật AVIF cho lưới này cộng với gallery đẩy số lần encode
            mỗi lần build lên hơn 1.100, build mất ~25 phút và dist phình lên 189MB —
            quá đắt cho 11 ô thumbnail crop vuông rộng ~240px, nơi AVIF gần như không
            hơn WebP về cảm nhận. AVIF chỉ giữ cho ảnh hero (LCP).

            quality 68: ô nhỏ và bị crop, hạ chất lượng ở cỡ này mắt không bắt được
            nhưng dung lượng giảm rõ.
          -->
          <Image
            src={project.data.cover}
            alt={`${project.data.title} — ${typeLabel(project.data.type)} tại ${project.data.location}`}
            quality={68}
            widths={TILE_WIDTHS}
            sizes={TILE_SIZES}
            loading={i < eagerCount ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding={i === 0 ? 'sync' : 'async'}
            data-img-fade={i < eagerCount ? undefined : true}
            class="tile-media h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-hover)] group-hover:scale-[1.04]"
          />

          <!--
            Gradient nhạt hơn hẳn ở mobile: trên desktop lớp phủ chỉ bật lúc hover
            nên đậm bao nhiêu cũng được, còn ở mobile nó bật thường trực cho cả 11
            ô — để nguyên from-black/80 thì cuộn xuống chỉ thấy một dãy hộp đen,
            ảnh công trình bị dìm mất nửa dưới.
          -->
          <div
            class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/55 via-black/5 to-transparent p-4 opacity-0 transition-opacity duration-500 ease-[var(--ease-hover)] group-hover:opacity-100 group-focus-visible:opacity-100 max-md:opacity-100 md:from-black/80 md:via-black/10 md:p-5"
          >
            <!--
              Mobile chỉ còn một dòng tên. Ô rộng ~187px nên "Căn hộ | Penthouse —
              2021" xuống ba dòng và đẩy ô lệch hẳn so với ô bên cạnh; hạng mục và
              năm vốn đã có ở chip lọc trang /projects lẫn trang chi tiết.
            -->
            <p class="line-clamp-1 text-sm leading-tight text-white md:line-clamp-2 md:text-base">
              {project.data.title}
            </p>
            <p
              class="hidden text-[0.625rem] tracking-[0.16em] text-white/75 uppercase md:mt-1.5 md:block"
            >
              {typeLabel(project.data.type)} — {project.data.year}
            </p>

            {/* Nhãn link hiện khi hover: nói rõ ô ảnh dẫn đi đâu, không để người
                xem phải đoán xem có bấm được không. */}
            <span
              class="mt-3 hidden text-[0.625rem] tracking-[0.16em] text-white uppercase md:block md:opacity-0 md:transition-opacity md:duration-500 md:ease-[var(--ease-hover)] md:group-hover:opacity-100"
            >
              Xem dự án
              <span class="ml-1.5 inline-block" aria-hidden="true">
                →
              </span>
            </span>
          </div>
        </a>
      </li>
    ))
  }

  {
    moreHref && (
      <li>
        <a
          href={moreHref}
          class="group flex aspect-square items-end bg-ink p-4 text-paper md:p-5"
        >
          <span class="text-[0.9375rem] leading-tight">
            {moreLabel}
            <span
              class="ml-2 inline-block transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:translate-x-1.5"
              aria-hidden="true"
            >
              →
            </span>
          </span>
        </a>
      </li>
    )
  }
</ul>

<style>
  /*
    :global vì <Image> của Astro không nhận attribute scope, nên selector bị bó
    scope sẽ không khớp với thẻ img nó sinh ra. Tên lớp chỉ dùng ở file này.
  */
  @media (hover: hover) {
    /*
      Nâng ảnh lên layer riêng ngay lúc trỏ vào ô. Không có bước này thì mỗi khung
      hình của phép phóng là một lần raster lại bitmap; ở đoạn cuối, khi bước scale
      nhỏ dần xuống dưới một pixel, mắt bắt được đúng chỗ đó thành ra thấy rung.

      Đặt trên :hover chứ không đặt sẵn: để sẵn thì 11 ô là 11 layer thường trú,
      tốn bộ nhớ ảnh mà 10 trong số đó không hề chuyển động.
    */
    :global(.group:hover .tile-media) {
      /* Khai cả scale: Tailwind 4 dịch scale-[1.04] ra thuộc tính `scale` riêng
         chứ không gộp vào `transform` nữa. */
      will-change: transform, scale;
    }
  }
</style>
