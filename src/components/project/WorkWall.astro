---
import { Image } from 'astro:assets';
import { projectPath } from '@/config/routes';
import { typeLabel } from '@/config/taxonomy';
import { coverAlt, type Project } from '@/lib/projects';

interface Props {
  projects: Project[];
  /**
   * Ô đầu tiên lớn gấp bốn (2 cột × 2 hàng) — dùng ở trang chủ để lưới có điểm nhấn.
   * Khi người xem lọc theo loại hình thì ô lớn tự trở về cỡ thường (xem TypeFilter).
   */
  feature?: boolean;
  /** Số ô tải eager — chỉ nên bằng số ô nằm trong màn hình đầu. */
  eagerCount?: number;
  /** Ô chữ chốt cuối lưới: điểm dừng, đồng thời lấp ô lẻ của hàng cuối. */
  moreHref?: string;
  moreLabel?: string;
}

const { projects, feature = false, eagerCount = 4, moreHref, moreLabel } = Astro.props;

// sizes bám đúng số cột 2 / md:3 / lg:4, lệch là trình duyệt tải nhầm bậc srcset.
const TILE_SIZES = '(min-width: 1024px) 25vw, (min-width: 768px) 33.33vw, 50vw';
const FEATURE_SIZES = '(min-width: 1024px) 50vw, (min-width: 768px) 66.66vw, 100vw';
const TILE_WIDTHS = [240, 360, 480, 720, 960];
const FEATURE_WIDTHS = [480, 720, 960, 1280, 1600];
---

<!--
  Lưới thoáng: ảnh 4:3 giữ khổ ngang của ảnh kiến trúc, có khoảng thở giữa các ô, chú
  thích nằm DƯỚI ảnh — ảnh không bị lớp phủ đè lên, tên + loại hình luôn đọc được.

  Mỗi ô là flex dọc với khung ảnh flex-1: ô thường thì khung giữ đúng 4:3, còn ô lớn
  (2×2) thì khung tự giãn lấp trọn hai hàng nên đáy ảnh vẫn thẳng với hàng bên cạnh.

  WebP một định dạng: AVIF cho thumbnail đốt thời gian build mà mắt không thấy khác.
-->
<ul
  class="work-wall grid grid-cols-2 gap-x-3 gap-y-7 px-5 md:grid-cols-3 md:gap-x-5 md:gap-y-10 md:px-10 lg:grid-cols-4"
  data-work-wall
>
  {
    projects.map((project, i) => {
      const isFeature = feature && i === 0;

      return (
        <li data-project-type={project.data.type} data-feature={isFeature ? '' : undefined}>
          <a href={projectPath(project.id)} class="group flex h-full flex-col">
            <div data-skeleton class="tile-frame aspect-[4/3] flex-1 overflow-hidden bg-paper-deep">
              <Image
                src={project.data.cover}
                alt={coverAlt(project)}
                quality={isFeature ? 76 : 70}
                widths={isFeature ? FEATURE_WIDTHS : TILE_WIDTHS}
                sizes={isFeature ? FEATURE_SIZES : TILE_SIZES}
                loading={i < eagerCount ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
                data-img-fade={i < eagerCount ? undefined : true}
                class="tile-media h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-hover)] group-hover:scale-[1.03]"
              />
            </div>

            <div class="mt-2.5 flex flex-col-reverse gap-0.5 md:mt-3 md:flex-row md:items-baseline md:justify-between md:gap-4">
              <p class="truncate text-sm leading-snug md:text-[0.9375rem]">
                <span class="link-underline">{project.data.title}</span>
              </p>
              <p class="shrink-0 text-[0.625rem] tracking-[0.14em] text-muted uppercase">
                {typeLabel(project.data.type)}
              </p>
            </div>
          </a>
        </li>
      );
    })
  }

  {
    moreHref && (
      <li data-more>
        <a href={moreHref} class="group flex h-full flex-col">
          <span class="flex aspect-[4/3] flex-1 items-end bg-ink p-4 text-paper transition-colors duration-500 group-hover:bg-ink-soft md:p-6">
            <span class="text-[0.9375rem] leading-tight md:text-lead">
              {moreLabel}
              <span
                class="ml-1.5 inline-block transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:translate-x-1.5"
                aria-hidden="true"
              >
                →
              </span>
            </span>
          </span>
          {/* Dòng trống giữ chỗ chú thích để đáy ô mực thẳng với đáy ảnh cùng hàng. */}
          <span class="mt-2.5 text-sm leading-snug md:mt-3 md:text-[0.9375rem]" aria-hidden="true">
            &nbsp;
          </span>
        </a>
      </li>
    )
  }
</ul>

<style>
  /*
    Ô lớn: trọn chiều ngang ở điện thoại (2 cột), 2×2 từ md. Khung ảnh bỏ tỉ lệ cứng
    để flex-1 kéo nó cao đúng bằng hai hàng.

    Tắt khi đang lọc ([data-filtered]): lúc đó ô đầu có thể đang ẩn, và một ô 2×2 đứng
    giữa vài kết quả lọc trông như lỗi.
  */
  .work-wall:not([data-filtered]) > li[data-feature] {
    grid-column: span 2;
  }

  .work-wall:not([data-filtered]) > li[data-feature] .tile-frame {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 768px) {
    .work-wall:not([data-filtered]) > li[data-feature] {
      grid-row: span 2;
    }

    .work-wall:not([data-filtered]) > li[data-feature] .tile-frame {
      aspect-ratio: auto;
    }
  }

  /*
    Có ô lớn thì lưới 4 cột dư đúng một ô ở hàng cuối (4 + 10 + 1 = 15). Ô chốt giãn
    2 cột để lấp. Chỉ ở lg: lưới 3 cột thì 15 ô đã vừa khít 5 hàng.
  */
  @media (min-width: 1024px) {
    .work-wall:not([data-filtered]):has(> li[data-feature]) > li[data-more] {
      grid-column: span 2;
    }

    .work-wall:not([data-filtered]):has(> li[data-feature]) > li[data-more] > a > span:first-child {
      aspect-ratio: auto;
    }
  }

  /* :global vì <Image> không nhận attribute scope. Nâng layer lúc hover để phép phóng
     không raster lại bitmap từng khung hình; `scale` vì Tailwind 4 tách khỏi transform. */
  @media (hover: hover) {
    :global(.group:hover .tile-media) {
      will-change: transform, scale;
    }
  }

  /* Hover cả ô thì gạch chân tên dự án chạy ra, không chỉ khi trỏ đúng dòng chữ. */
  :global(.group:hover .link-underline::after) {
    transform: scaleX(1);
  }
</style>
