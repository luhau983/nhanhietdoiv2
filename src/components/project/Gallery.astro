---
// WebP một định dạng: 73 ảnh gallery nhân AVIF là phần đốt build nhiều nhất
// (đo được ~25 phút build, dist 189MB). Ảnh gallery đều lazy dưới màn hình đầu nên
// AVIF ít giá trị nhất ở đây; chỉ hero giữ AVIF.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  gallery: CollectionEntry<'projects'>['data']['gallery'];
  title: string;
}

const { gallery, title } = Astro.props;

// Ảnh hẹp bị chặn ở max-w-4xl (56rem = 896px) nên DPR 2 chỉ cần tới ~1800px;
// ở mobile khối chiếm 92vw.
const NARROW_SIZES = '(min-width: 1024px) 56rem, 92vw';
---

{
  gallery.length > 0 && (
    <div class="space-y-16 md:space-y-28">
      {gallery.map((item, i) =>
        item.wide ? (
          // Ảnh tràn viền: dùng cho toàn cảnh, mặt đứng. Tạo nhịp nghỉ giữa các
          // đoạn nội dung hẹp.
          <figure data-reveal>
            <div class="relative overflow-hidden bg-paper-deep">
              <Image
                src={item.src}
                alt={item.caption ?? `${title} — ảnh ${i + 1}`}
                widths={[480, 768, 1280, 1800, 2400]}
                sizes="100vw"
                loading="lazy"
                decoding="async"
                data-img-fade
                class="w-full"
              />
            </div>
            {item.caption && (
              <figcaption class="label mt-3 px-5 md:px-10">{item.caption}</figcaption>
            )}
          </figure>
        ) : (
          // Canh trái theo đúng trục của tiêu đề và phần chữ phía trên, bỏ mx-auto:
          // ảnh hẹp canh giữa xen giữa các khối canh trái làm trang gãy nhịp.
          <figure class="px-5 md:px-10" data-reveal>
            <div class="max-w-4xl">
              <div class="relative overflow-hidden bg-paper-deep">
                <Image
                  src={item.src}
                  alt={item.caption ?? `${title} — ảnh ${i + 1}`}
                  widths={[480, 640, 960, 1400, 1800]}
                  sizes={NARROW_SIZES}
                  loading="lazy"
                  decoding="async"
                  data-img-fade
                  class="w-full"
                />
              </div>
              {item.caption && <figcaption class="label mt-3">{item.caption}</figcaption>}
            </div>
          </figure>
        ),
      )}
    </div>
  )
}
