---
import { TYPE_PARAM } from '@/config/routes';
import type { TypeCount } from '@/lib/projects';

interface Props {
  /** Mọi loại hình kèm số dự án — từ countByType(). */
  types: TypeCount[];
  total: number;
  class?: string;
}

const { types, total, class: className } = Astro.props;

/*
  Hiện ĐỦ mọi loại hình studio nhận làm, kể cả loại chưa có dự án đăng: khách cần
  biết studio làm được gì, không chỉ cái gì đã chụp ảnh. Loại có dự án là nút lọc
  kèm số đếm; loại chưa có chỉ là chữ mờ — không bấm ra lưới trống.
*/
const withProjects = types.filter((t) => t.count > 0);
const withoutProjects = types.filter((t) => t.count === 0);
---

<div
  class:list={[
    'type-filter flex items-center gap-x-8 overflow-x-auto px-5 md:px-10',
    // Điện thoại: dính ngay dưới header để đang cuộn giữa lưới vẫn đổi được loại hình.
    'max-md:sticky max-md:top-[var(--header-h)] max-md:z-30 max-md:border-b max-md:border-line max-md:bg-paper/95 max-md:backdrop-blur-sm',
    className,
  ]}
  data-type-filter
  data-param={TYPE_PARAM}
>
  <p class="label shrink-0 max-md:hidden">Loại hình</p>

  <ul class="chips flex items-center gap-2 whitespace-nowrap md:flex-wrap">
    <li class="pill" role="presentation" aria-hidden="true" data-type-pill></li>
    <li>
      <button type="button" class="chip" data-filter="all" aria-pressed="true">
        Tất cả <sup>{total}</sup>
      </button>
    </li>
    {
      withProjects.map((type) => (
        <li>
          <button type="button" class="chip" data-filter={type.slug} aria-pressed="false">
            {type.label} <sup>{type.count}</sup>
          </button>
        </li>
      ))
    }
    {
      withoutProjects.map((type) => (
        <li class="chip chip-off">{type.label}</li>
      ))
    }
  </ul>
</div>

<p class="label hidden px-5 py-16 md:px-10" data-type-empty>Chưa có dự án trong loại hình này.</p>

<style>
  .type-filter {
    --pill-fill: color-mix(in oklab, var(--color-ink) 8%, var(--color-paper));
    scrollbar-width: none;
    padding-block: 0.5rem;
  }

  .type-filter::-webkit-scrollbar {
    display: none;
  }

  /*
    Viên bo tròn. Loại đang chọn có nền xám ấm, viền mực và chữ đậm — khác rõ so với các
    viên viền nhạt bên cạnh, nên liếc qua là biết đang xem loại nào. Bản trước chỉ gạch
    chân 1px: giữa một hàng chữ cùng cỡ thì gần như không thấy.

    Cao 40px: sát ngưỡng vùng chạm, mà hàng vẫn mảnh khi dính dưới header trên điện thoại.
  */
  .chip {
    display: inline-flex;
    height: 2.5rem;
    align-items: center;
    gap: 0.35em;
    padding-inline: 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    transition:
      background-color 0.35s var(--ease-hover),
      border-color 0.35s var(--ease-hover),
      color 0.35s var(--ease-hover);
  }

  button.chip {
    cursor: pointer;
  }

  button.chip:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  /* Tông sáng: nền xám ấm + viền mực 1px + chữ đậm hơn một bậc. Khối mực đặc đã thử và
     quá nặng — nó hút mắt hơn cả ảnh công trình ngay bên dưới. */
  .chip[aria-pressed='true'] {
    border-color: var(--color-ink);
    background-color: var(--pill-fill);
    color: var(--color-ink);
    font-weight: 500;
  }

  /*
    Cục nền TRƯỢT giữa các viên: một phần tử duy nhất đổi vị trí và bề rộng theo viên
    đang chọn, thay vì viên này tắt nền, viên kia bật nền. Mắt theo được chuyển động nên
    biết mình vừa đi từ loại nào sang loại nào.

    Chỉ nhận việc khi JS đã đo xong ([data-pill]); trước đó viên đang chọn tự tô nền như
    cũ, nên không JS thì vẫn thấy rõ đang ở loại nào.

    view-transition-name: lúc đổi bộ lọc trang đang nằm trong một view transition, không
    có tên riêng thì cục nền chỉ hoà mờ theo nền trang chứ không trượt. Khi đó tắt
    transition CSS ([data-vt]) để hai cơ chế không cùng đẩy một phần tử.
  */
  .chips {
    position: relative;
  }

  .chip {
    position: relative;
    z-index: 1;
  }

  .pill {
    position: absolute;
    top: 0;
    left: 0;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-ink);
    background-color: var(--pill-fill);
    opacity: 0;
    pointer-events: none;
    view-transition-name: type-pill;
  }

  [data-pill] .pill {
    opacity: 1;
  }

  [data-pill='ready']:not([data-vt]) .pill {
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-pill] .chip[aria-pressed='true'] {
    border-color: transparent;
    background-color: transparent;
  }

  .chip sup {
    top: -0.35em;
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  /* Loại chưa có dự án: không viền, không bấm được — chỉ để biết studio có nhận. */
  .chip-off {
    padding-inline: 0.5rem;
    border-color: transparent;
    color: color-mix(in oklab, var(--color-muted) 60%, transparent);
  }
</style>

<script>
  function initTypeFilter(): void {
    const bar = document.querySelector<HTMLElement>('[data-type-filter]');
    const wall = document.querySelector<HTMLElement>('[data-work-wall]');
    if (!bar || !wall || bar.dataset.ready) return;
    bar.dataset.ready = 'true';

    const param = bar.dataset.param ?? 'loai';
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const items = Array.from(wall.querySelectorAll<HTMLElement>('[data-project-type]'));
    const empty = document.querySelector<HTMLElement>('[data-type-empty]');
    const pill = bar.querySelector<HTMLElement>('[data-type-pill]');
    const barEl = bar;

    /** Đặt cục nền trùng khít viên đang chọn. offsetLeft/Top tính theo <ul> (position: relative). */
    function movePill(): void {
      const active = buttons.find((btn) => btn.getAttribute('aria-pressed') === 'true');
      if (!pill || !active) return;

      pill.style.width = `${active.offsetWidth}px`;
      pill.style.transform = `translate(${active.offsetLeft}px, ${active.offsetTop}px)`;
      if (!barEl.dataset.pill) barEl.dataset.pill = 'placed';
    }

    /** Điện thoại: hàng viên cuộn ngang — đưa viên vừa chọn về giữa để thấy cả hai bên. */
    function centerActive(): void {
      const active = buttons.find((btn) => btn.getAttribute('aria-pressed') === 'true');
      if (!active || barEl.scrollWidth <= barEl.clientWidth) return;

      const left = active.offsetLeft - (barEl.clientWidth - active.offsetWidth) / 2;
      barEl.scrollTo({ left, behavior: 'smooth' });
    }

    function apply(type: string, updateUrl: boolean): void {
      let visible = 0;

      items.forEach((item) => {
        const match = type === 'all' || item.dataset.projectType === type;
        item.hidden = !match;
        if (match) visible += 1;
      });

      buttons.forEach((btn) => {
        btn.setAttribute('aria-pressed', String(btn.dataset.filter === type));
      });

      movePill();
      if (updateUrl) centerActive();

      empty?.classList.toggle('hidden', visible > 0);

      // Thanh đang dính mà lưới ngắn lại thì kéo đầu lưới về ngay dưới thanh, không để
      // người xem đứng giữa khoảng trống của phần đã bị lọc mất.
      if (updateUrl && wall && wall.getBoundingClientRect().top < 0) {
        const y = window.scrollY + wall.getBoundingClientRect().top - bar!.offsetHeight - bar!.offsetTop;
        if (window.__lenis) window.__lenis.scrollTo(y, { immediate: true });
        else window.scrollTo(0, y);
      }
      // Lưới bỏ ô lớn 2×2 khi đang lọc — xem WorkWall.
      wall?.toggleAttribute('data-filtered', type !== 'all');

      if (!updateUrl) return;
      // replaceState: link đã lọc chia sẻ được, nhưng nút back không phải lùi qua từng lần bấm.
      const url = new URL(window.location.href);
      if (type === 'all') url.searchParams.delete(param);
      else url.searchParams.set(param, type);
      window.history.replaceState(window.history.state, '', url);
    }

    /*
      Đổi bộ lọc bên trong một view transition: mỗi ô ảnh đã có view-transition-name
      riêng (dùng cho hiệu ứng mở dự án), nên trình duyệt tự nội suy — ô còn lại TRƯỢT
      về vị trí mới, ô bị lọc mờ đi — thay vì cả lưới nhảy cóc trong một khung hình.

      Trình duyệt chưa hỗ trợ, hoặc người dùng tắt chuyển động: đổi thẳng như cũ.
    */
    function transition(type: string): void {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('startViewTransition' in document)) {
        apply(type, true);
        return;
      }

      barEl.dataset.vt = '';
      const vt = document.startViewTransition(() => apply(type, true));
      void vt.finished.finally(() => delete barEl.dataset.vt);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => transition(btn.dataset.filter ?? 'all'));
    });

    // Tôn trọng ?loai= khi vào từ link ngoài (trang dịch vụ, footer).
    const initial = new URL(window.location.href).searchParams.get(param);
    if (initial && buttons.some((b) => b.dataset.filter === initial)) apply(initial, false);

    // Đặt lần đầu không chạy animation; sau một khung hình mới cho phép trượt. Đo lại khi
    // font tải xong hoặc hàng viên đổi kích thước (xoay máy, xuống dòng ở màn hẹp).
    movePill();
    requestAnimationFrame(() => {
      if (barEl.dataset.pill) barEl.dataset.pill = 'ready';
    });
    void document.fonts.ready.then(movePill);
    new ResizeObserver(movePill).observe(barEl);
  }

  // Script bị hoist sau khi ClientRouter đã bắn astro:page-load nên phải gọi thẳng một lần.
  document.addEventListener('astro:page-load', initTypeFilter);
  initTypeFilter();
</script>
