---
import { ROUTES } from '@/config/routes';
import { site } from '@/config/site';

interface Props {
  /**
   * Khối liên hệ (email, điện thoại, mạng xã hội). Tắt ở trang đã có lời mời liên hệ
   * ngay phía trên (ClosingCta, trang liên hệ) — mời hai lần liền nhau làm yếu cả hai.
   */
  showContact?: boolean;
}

const { showContact = true } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="border-t border-line px-5 md:px-10">
  {
    showContact && (
      <div class="grid gap-10 py-14 md:grid-cols-12 md:py-20">
        <div class="md:col-span-6">
          <a
            href={ROUTES.contact}
            class="link-underline text-display leading-none font-light tracking-[-0.025em]"
          >
            Liên hệ
          </a>
        </div>

        <ul class="space-y-1.5 text-sm text-ink-soft md:col-span-3">
          <li>
            <a href={`tel:${site.phoneHref}`} class="link-underline">
              {site.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="link-underline">
              {site.email}
            </a>
          </li>
          {site.address && <li class="max-w-[26ch] pt-3 text-muted">{site.address}</li>}
        </ul>

        <ul class="space-y-1.5 text-sm text-ink-soft md:col-span-3">
          {site.socials.map((s) => (
            <li>
              <a href={s.href} class="link-underline" target="_blank" rel="noopener noreferrer">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div
    class:list={[
      'flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-6 text-xs text-muted',
      showContact && 'border-t border-line',
    ]}
  >
    <p>© {year} {site.legalName}</p>

    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Chân trang">
      {
        site.nav.map((item) => (
          <a href={item.href} class="link-underline">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
