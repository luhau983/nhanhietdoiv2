---
import { getImage } from 'astro:assets';
import landscape from '@/assets/hero.jpg';

interface Props {
  alt: string;
}

const { alt } = Astro.props;

/*
  Một nguồn ảnh ngang cho mọi khổ — KHÔNG còn art direction bằng ảnh dọc.

  Trước đây hero là khung dọc cao 74svh trên điện thoại nên phải có bản cắt dọc
  riêng (@/assets/hero-portrait.jpg), nếu không object-cover sẽ cắt hai bên ảnh
  ngang rất nhiều. Giờ hero là ô đầu của lưới, tỉ lệ 4:3 ở mobile và 3:1 ở desktop
  — cả hai đều là khung ngang, nên bản cắt dọc không còn khung nào để phục vụ.

  hero-portrait.jpg vì vậy thành tài sản không dùng tới; để lại trong assets phòng
  khi cần dựng lại hero dọc, Astro không đóng gói ảnh nào không được import.
*/
const [avif, webp, fallback] = await Promise.all([
  getImage({ src: landscape, widths: [640, 900, 1280, 1800, 2400], format: 'avif' }),
  getImage({ src: landscape, widths: [640, 900, 1280, 1800, 2400], format: 'webp' }),
  getImage({ src: landscape, width: 1800, format: 'jpeg' }),
]);
---

<picture>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes="100vw" />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes="100vw" />
  <img
    src={fallback.src}
    alt={alt}
    width={landscape.width}
    height={landscape.height}
    loading="eager"
    fetchpriority="high"
    decoding="sync"
    data-parallax="10"
    class="h-full w-full object-cover"
  />
</picture>
