---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
import { site } from '@/config/site';

const path = Astro.url.pathname;

function isActive(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<!--
  Một trạng thái duy nhất: nền giấy mờ + viền dưới, chữ mực.

  Trước đây header có thêm trạng thái trong suốt chữ trắng khi nằm trên ảnh hero.
  Bỏ hẳn vì logo là ảnh raster màu cố định, trong đó dòng "THE ARCHITECTURE STUDIO"
  màu đen: đặt lên ảnh công trình thì không lớp scrim nào lo được cho cả chữ cam
  lẫn chữ đen — làm scrim đủ tối cho chữ cam thì chữ đen chìm, làm nhạt cho chữ đen
  thì chữ cam chìm. Đổ trắng toàn bộ logo thì giải quyết được tương phản nhưng mất
  màu nhận diện, mà màu là thứ không được phép mất.

  Nền cố định còn xoá luôn hai thứ rắc rối: lớp scrim, và việc chữ hero trượt lên
  chui vào sau header trong suốt.
-->
<header
  class="fixed inset-x-0 top-0 z-50 border-b border-line bg-paper/90 text-ink backdrop-blur-sm"
  data-site-header
>
  <!--
    Checkbox đứng đầu header để mọi phần còn lại đều là sibling phía sau — nhờ vậy
    trạng thái mở menu điều khiển được thanh header bằng `~`, không cần JS.

    Menu mobile bằng checkbox: tự reset sau mỗi lần điều hướng.
  -->
  <input id="nav-toggle" type="checkbox" class="peer sr-only" />

  <div
    class="invisible fixed inset-0 bg-paper text-ink opacity-0 transition-[opacity,visibility] duration-500 ease-[var(--ease-out-expo)] max-md:peer-checked:visible max-md:peer-checked:opacity-100 md:hidden"
  >
    <nav class="flex h-full flex-col justify-center gap-2 px-6" aria-label="Menu chính">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="py-3 text-title font-light tracking-tight"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={`mailto:${site.email}`} class="label mt-8">{site.email}</a>
    </nav>
  </div>

  <div class="nav-bar relative flex items-center justify-between px-5 py-2.5 md:px-10 md:py-5">
    <!--
      Logo lấy từ nhận diện cũ của studio: hoa thiên điểu, chữ cam, dòng phụ đen.
      Luôn giữ nguyên màu — không đổ trắng, không lọc màu ở bất kỳ trạng thái nào.
    -->
    <a href="/" aria-label={`${site.name} — về trang chủ`}>
      <Image
        src={logo}
        alt={site.name}
        densities={[1, 2]}
        loading="eager"
        class="site-logo h-8 w-auto md:h-9"
      />
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Menu chính">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="link-underline text-sm tracking-wide"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!--
      h-11/w-11 = 44px: ngưỡng tối thiểu cho vùng chạm trên cảm ứng.

      Ba gạch thay cho chữ "Menu": ở khổ 375px mỗi ký tự chữ hoa giãn 0.18em ăn
      gần 90px chiều ngang cạnh tên studio, mà biểu tượng chỉ tốn 22px và không
      phải dịch. Ba gạch gập thành dấu X khi mở nên không cần nhãn "Đóng" nữa.

      Chữ vẫn còn ở dạng sr-only và vẫn đổi theo trạng thái — đó là tên khả dụng
      của checkbox, bỏ đi thì trình đọc màn hình chỉ đọc được "checkbox".
    -->
    <label
      for="nav-toggle"
      class="-mr-2 flex h-11 w-11 cursor-pointer items-center justify-end select-none md:hidden"
    >
      <span class="nav-label-open sr-only">Mở menu</span>
      <span class="nav-label-close sr-only">Đóng menu</span>

      <span class="nav-burger" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </label>
  </div>
</header>

<style>
  /* Khoá scroll khi menu mở. :has() tránh phải viết JS toggle class lên body. */
  :global(body:has(#nav-toggle:checked)) {
    overflow: hidden;
  }

  /*
    Overlay menu nằm TRƯỚC thanh header trong DOM nên thanh header vẽ đè lên — cố ý,
    để logo và nút đóng luôn bấm được.

    Dùng `~` thay vì :has() để không phụ thuộc vào cách Astro chèn attribute scope
    vào trong đối số của :has().
  */
  .nav-label-close {
    display: none;
  }

  #nav-toggle:checked ~ .nav-bar .nav-label-open {
    display: none;
  }

  #nav-toggle:checked ~ .nav-bar .nav-label-close {
    display: inline;
  }

  /*
    Ba gạch 22×12: gạch giữa nằm đúng tâm nên khi mở, gạch trên và gạch dưới chỉ
    cần trượt về tâm rồi xoay ±45° là thành dấu X cân. Vạch 1px hợp với nét chữ
    mảnh của header; dày hơn thì nút nặng hơn cả tên studio bên trái.
  */
  .nav-burger {
    position: relative;
    display: block;
    width: 1.375rem;
    height: 0.75rem;
  }

  .nav-burger span {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transition:
      transform 0.4s var(--ease-out-expo),
      opacity 0.2s linear;
  }

  .nav-burger span:nth-child(1) {
    top: 0;
  }

  .nav-burger span:nth-child(2) {
    top: 50%;
  }

  .nav-burger span:nth-child(3) {
    top: 100%;
  }

  #nav-toggle:checked ~ .nav-bar .nav-burger span:nth-child(1) {
    transform: translateY(0.375rem) rotate(45deg);
  }

  #nav-toggle:checked ~ .nav-bar .nav-burger span:nth-child(2) {
    opacity: 0;
  }

  #nav-toggle:checked ~ .nav-bar .nav-burger span:nth-child(3) {
    transform: translateY(-0.375rem) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-burger span {
      transition: none;
    }
  }
</style>
