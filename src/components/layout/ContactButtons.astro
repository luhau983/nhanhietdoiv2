---
import { contactChannels } from '@/config/site';

// Kênh mở tab mới thì cần rel bảo vệ; tel:/mailto: thì không.
function isExternal(href: string) {
  return href.startsWith('http');
}
---

<!--
  Một nút tròn, bung ra 4 kênh khi hover (desktop) hoặc khi bấm (mọi thiết bị).
  Bấm lần nữa thì đóng, và đóng bằng cách bấm sẽ chặn hover mở lại cho tới khi
  chuột rời khỏi nút — không có bước này thì trên desktop bấm đóng xong hover
  vẫn đang bật nên panel mở lại ngay, người dùng tưởng nút hỏng.

  Bốn kênh này cũng có ở footer và trang /contact, nên nút nổi chỉ là đường tắt.
-->
<div class="contact-fab fixed right-4 bottom-4 z-40 flex flex-col items-end gap-2 md:right-6 md:bottom-6">
  <div class="contact-panel flex flex-col items-end gap-2" id="contact-panel">
    {
      contactChannels.map((channel, i) => (
        <a
          href={channel.href}
          class="rounded-full bg-ink px-5 py-2.5 text-[0.6875rem] tracking-[0.16em] text-paper uppercase transition-colors duration-300 hover:bg-ink-soft"
          style={`--stagger: ${i * 40}ms`}
          target={isExternal(channel.href) ? '_blank' : undefined}
          rel={isExternal(channel.href) ? 'noopener noreferrer' : undefined}
        >
          {channel.label}
        </a>
      ))
    }
  </div>

  <button
    type="button"
    class="contact-trigger flex h-14 w-14 cursor-pointer items-center justify-center rounded-full bg-ink text-paper"
    aria-expanded="false"
    aria-controls="contact-panel"
  >
    <!-- Glyph ống nghe: không mượn nhận diện của Zalo/Messenger, và rõ ở 20px. -->
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-5 w-5"
      aria-hidden="true"
    >
      <path
        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
      ></path>
    </svg>
    <span class="sr-only">Kênh liên hệ</span>
  </button>
</div>

<style>
  /*
    Trạng thái hiện/ẩn viết bằng selector tự đặt chứ không dùng biến thể Tailwind:
    Tailwind 4 bọc peer-*/group-* trong :where() nên chúng không cộng specificity —
    `group-hover:visible` hoà 0,1,0 với `invisible` rồi thua theo thứ tự khai báo.
  */
  .contact-panel {
    visibility: hidden;
    opacity: 0;
    transform: translateY(0.5rem);
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease-out-expo),
      transform 0.3s var(--ease-out-expo),
      visibility 0.3s;
  }

  .contact-panel > a {
    transition-delay: var(--stagger, 0ms);
  }

  .contact-trigger {
    transition: transform 0.5s var(--ease-out-expo);
  }

  .contact-fab[data-open] .contact-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .contact-fab[data-open] .contact-trigger {
    transform: rotate(135deg);
  }

  @media (hover: hover) {
    .contact-fab:hover .contact-trigger {
      transform: scale(1.05);
    }

    .contact-fab[data-open]:hover .contact-trigger {
      transform: rotate(135deg);
    }
  }
</style>

<script>
  /*
    Uỷ quyền sự kiện ở cấp module, không gắn listener lên từng phần tử.

    Vì sao: script của component nằm ở cuối <body> nên chạy SAU khi ClientRouter
    (ở <head>) đã bắn astro:page-load. Nếu chỉ đăng ký trong listener page-load
    thì lần tải đầu không bao giờ khởi tạo được. Cách này chạy ngay khi module
    thực thi, và sống sót qua View Transitions vì listener nằm trên document
    chứ không nằm trên phần tử bị thay.
  */
  const canHover = window.matchMedia('(hover: hover)');

  // Sau khi bấm đóng, chặn hover mở lại cho tới khi con trỏ rời hẳn khỏi nút —
  // không có cái này thì trên desktop bấm đóng xong hover vẫn bật nên panel mở
  // lại ngay, người dùng tưởng nút hỏng.
  let hoverBlocked = false;

  function fabFrom(target: EventTarget | null) {
    return target instanceof Element ? target.closest<HTMLElement>('.contact-fab') : null;
  }

  function setOpen(fab: HTMLElement, open: boolean) {
    fab.toggleAttribute('data-open', open);
    fab.querySelector('.contact-trigger')?.setAttribute('aria-expanded', String(open));
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest('.contact-trigger');
    if (!trigger) return;

    const fab = fabFrom(trigger);
    if (!fab) return;

    const willOpen = !fab.hasAttribute('data-open');
    setOpen(fab, willOpen);
    hoverBlocked = !willOpen;
  });

  // mouseover/mouseout nổi bọt lên document, còn mouseenter/mouseleave thì không —
  // nên uỷ quyền phải dùng cặp này và tự kiểm tra relatedTarget.
  document.addEventListener('mouseover', (event) => {
    const fab = fabFrom(event.target);
    if (!fab || !canHover.matches || hoverBlocked) return;
    setOpen(fab, true);
  });

  document.addEventListener('mouseout', (event) => {
    const fab = fabFrom(event.target);
    if (!fab || !canHover.matches) return;

    const next = (event as MouseEvent).relatedTarget;
    if (next instanceof Node && fab.contains(next)) return; // con trỏ vẫn trong nút

    hoverBlocked = false;
    setOpen(fab, false);
  });

  // Bàn phím: Tab vào là mở, rời khỏi nhóm là đóng. focusin/focusout nổi bọt.
  document.addEventListener('focusin', (event) => {
    const fab = fabFrom(event.target);
    if (fab) setOpen(fab, true);
  });

  document.addEventListener('focusout', (event) => {
    const fab = fabFrom(event.target);
    if (!fab) return;

    const next = (event as FocusEvent).relatedTarget;
    if (next instanceof Node && fab.contains(next)) return;

    setOpen(fab, false);
  });

  // Chạm ra ngoài để đóng trên mobile — không có hover để dựa vào.
  document.addEventListener('pointerdown', (event) => {
    if (fabFrom(event.target)) return;
    document
      .querySelectorAll<HTMLElement>('.contact-fab[data-open]')
      .forEach((fab) => setOpen(fab, false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document
      .querySelectorAll<HTMLElement>('.contact-fab[data-open]')
      .forEach((fab) => setOpen(fab, false));
  });
</script>
