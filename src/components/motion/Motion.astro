---
/**
 * Motion bằng JS của toàn site — chỉ còn hai việc nhẹ: reveal khi cuộn tới và đánh dấu
 * ảnh đã tải. Cả hai dùng IntersectionObserver / sự kiện load, không có vòng lặp theo
 * khung hình nào.
 *
 * Cuộn trang là cuộn NATIVE của trình duyệt. Bản trước dùng Lenis (cuộn mượt bằng JS):
 * mỗi khung hình chạy một lượt JS trên main thread để tự đặt vị trí cuộn, nên máy yếu
 * hay trang nhiều ảnh là thấy trễ và giật — đúng thứ người dùng báo là "lag". Cuộn
 * native chạy trên compositor, không tốn JS.
 *
 * Parallax là CSS scroll-driven animation trong global.css, cũng không qua JS.
 * Mọi thứ re-init theo astro:page-load để hoạt động với View Transitions.
 */
---

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  let cleanups: Array<() => void> = [];

  function teardown() {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  }

  function initReveal() {
    const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!targets.length) return;

    if (reduced.matches) {
      targets.forEach((el) => el.setAttribute('data-revealed', ''));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute('data-revealed', '');
          observer.unobserve(entry.target);
        });
      },
      // Kích hoạt khi phần tử vào 12% dưới viewport: người dùng thấy chuyển động
      // đang diễn ra chứ không thấy nó bắt đầu từ số 0.
      { rootMargin: '0px 0px -12% 0px', threshold: 0.01 },
    );

    targets.forEach((el) => observer.observe(el));
    cleanups.push(() => observer.disconnect());
  }

  /*
    Ảnh load xong thì cho nó hiện lên và tắt skeleton của khung chứa nó.

    Quét hai nhóm rồi gộp qua Set vì chúng chồng nhau một phần: [data-img-fade] là
    ảnh tự mờ dần, còn ảnh nằm trong [data-skeleton] gồm cả ảnh eager không fade —
    khung của chúng vẫn phải tắt vệt sáng, nếu không lưới quét sáng vĩnh viễn.
  */
  function initImageLoading() {
    const images = new Set<HTMLImageElement>([
      ...document.querySelectorAll<HTMLImageElement>('[data-img-fade]'),
      ...document.querySelectorAll<HTMLImageElement>('[data-skeleton] img'),
    ]);

    images.forEach((img) => {
      const done = () => {
        img.classList.add('is-loaded');
        img.closest('[data-skeleton]')?.setAttribute('data-loaded', '');
      };

      // Ảnh đã nằm sẵn trong cache thì load event không bắn nữa.
      if (img.complete) {
        done();
        return;
      }

      img.addEventListener('load', done, { once: true });
      // Ảnh lỗi cũng phải tắt skeleton: để nó quét mãi thì người xem tưởng mạng còn
      // đang tải, thay vì thấy ngay là ô đó không có ảnh.
      img.addEventListener('error', done, { once: true });
    });
  }

  function boot() {
    teardown();
    initReveal();
    initImageLoading();
  }

  // astro:page-load chạy cả lần tải đầu và sau mỗi lần điều hướng View Transitions.
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', teardown);

  // Đổi cài đặt reduced-motion giữa phiên thì áp dụng ngay, không cần reload.
  reduced.addEventListener('change', boot);
</script>
