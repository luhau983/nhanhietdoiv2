---
/**
 * Nơi duy nhất khởi tạo motion cho toàn site: smooth scroll, reveal, parallax.
 *
 * Ba nguyên tắc:
 * 1. GSAP chỉ tải khi trang thực sự có phần tử [data-parallax] — trang liên hệ
 *    không cần trả 50KB JS.
 * 2. prefers-reduced-motion tắt sạch Lenis và GSAP, không chỉ rút ngắn thời lượng.
 * 3. Mọi thứ re-init theo astro:page-load để hoạt động với View Transitions.
 */
---

<script>
  import Lenis from 'lenis';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  let lenis: Lenis | null = null;
  let cleanups: Array<() => void> = [];

  function teardown() {
    cleanups.forEach((fn) => fn());
    cleanups = [];
    lenis?.destroy();
    lenis = null;
  }

  function initSmoothScroll() {
    if (reduced.matches) return;

    lenis = new Lenis({
      duration: 1.1,
      // Đường cong giảm dần: nhanh lúc đầu, dừng mềm. Cảm giác "nặng" đúng chất
      // site kiến trúc, không trôi tuột như ease-linear.
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      wheelMultiplier: 0.9,
      touchMultiplier: 1.6,
      // Mobile dùng scroll native: Lenis trên touch thường phản tác dụng.
      smoothWheel: true,
      syncTouch: false,
    });

    let frame = requestAnimationFrame(function raf(time) {
      lenis?.raf(time);
      frame = requestAnimationFrame(raf);
    });

    // Công khai instance để nút "về đầu trang" cuộn qua Lenis. Nếu nó tự gọi
    // window.scrollTo thì vị trí nội bộ của Lenis lệch khỏi vị trí thật.
    window.__lenis = lenis;

    cleanups.push(() => {
      cancelAnimationFrame(frame);
      delete window.__lenis;
    });
  }

  function initReveal() {
    const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!targets.length) return;

    if (reduced.matches) {
      targets.forEach((el) => el.setAttribute('data-revealed', ''));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.setAttribute('data-revealed', '');
          observer.unobserve(entry.target);
        });
      },
      // Kích hoạt khi phần tử vào 12% dưới viewport: người dùng thấy chuyển động
      // đang diễn ra chứ không thấy nó bắt đầu từ số 0.
      { rootMargin: '0px 0px -12% 0px', threshold: 0.01 },
    );

    targets.forEach((el) => observer.observe(el));
    cleanups.push(() => observer.disconnect());
  }

  /*
    Ảnh load xong thì cho nó hiện lên và tắt skeleton của khung chứa nó.

    Quét hai nhóm rồi gộp qua Set vì chúng chồng nhau một phần: [data-img-fade] là
    ảnh tự mờ dần, còn ảnh nằm trong [data-skeleton] gồm cả ảnh eager không fade —
    khung của chúng vẫn phải tắt vệt sáng, nếu không lưới quét sáng vĩnh viễn.
  */
  function initImageLoading() {
    const images = new Set<HTMLImageElement>([
      ...document.querySelectorAll<HTMLImageElement>('[data-img-fade]'),
      ...document.querySelectorAll<HTMLImageElement>('[data-skeleton] img'),
    ]);

    images.forEach((img) => {
      const done = () => {
        img.classList.add('is-loaded');
        img.closest('[data-skeleton]')?.setAttribute('data-loaded', '');
      };

      // Ảnh đã nằm sẵn trong cache thì load event không bắn nữa.
      if (img.complete) {
        done();
        return;
      }

      img.addEventListener('load', done, { once: true });
      // Ảnh lỗi cũng phải tắt skeleton: để nó quét mãi thì người xem tưởng mạng còn
      // đang tải, thay vì thấy ngay là ô đó không có ảnh.
      img.addEventListener('error', done, { once: true });
    });
  }

  /*
    Tắt vệt sáng skeleton của những khung đã trôi xa khỏi màn hình — xem chú thích
    [data-skeleton] trong global.css để biết vì sao đánh dấu theo chiều "tắt".

    rootMargin 300px: tắt hẳn khi đã ra xa, chứ không tắt ngay ở mép màn hình. Khung vừa
    trôi khỏi tầm mắt một chút mà đã dừng thì lúc cuộn ngược lại nó bật lên giữa chu kỳ,
    thành một cú giật sáng.

    Khung nằm trong <dialog> thì không theo dõi: lúc hộp thoại đóng nó là display:none nên
    animation đã tự huỷ, mà đánh dấu thì nó bị coi là ngoài màn hình rồi tới lúc mở chưa
    chắc kịp bỏ dấu — lớp xem ảnh sẽ mất skeleton đúng chỗ cần nhất.
  */
  function initSkeletonSweep() {
    const frames = [...document.querySelectorAll<HTMLElement>('[data-skeleton]')].filter(
      (el) => !el.closest('dialog'),
    );
    if (!frames.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) delete el.dataset.offscreen;
          else el.dataset.offscreen = '';
        });
      },
      { rootMargin: '300px 0px' },
    );

    frames.forEach((el) => observer.observe(el));
    cleanups.push(() => observer.disconnect());
  }

  async function initParallax() {
    const targets = document.querySelectorAll<HTMLElement>('[data-parallax]');
    if (!targets.length || reduced.matches) return;

    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);

    // Lenis không phát scroll event của window, phải đẩy tay sang ScrollTrigger.
    if (lenis) {
      const onScroll = () => ScrollTrigger.update();
      lenis.on('scroll', onScroll);
      cleanups.push(() => lenis?.off('scroll', onScroll));
    }

    targets.forEach((el) => {
      const strength = Number(el.dataset.parallax || '12');
      gsap.fromTo(
        el,
        { yPercent: -strength / 2 },
        {
          yPercent: strength / 2,
          ease: 'none',
          scrollTrigger: {
            trigger: el.parentElement ?? el,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        },
      );
    });

    ScrollTrigger.refresh();

    cleanups.push(() => {
      ScrollTrigger.getAll().forEach((t) => t.kill());
      gsap.killTweensOf(targets);
    });
  }

  /*
    Không còn initHeaderTheme.

    Header từng có hai trạng thái — trong suốt chữ trắng khi nằm trên ảnh hero, nền
    giấy chữ mực khi hết hero — do một IntersectionObserver ở đây bật/tắt. Bỏ đi vì
    logo là ảnh raster màu cố định phải giữ nguyên màu ở mọi nơi, nên header buộc
    phải có nền ổn định. Xem phần chú thích đầu Header.astro.
  */
  function boot() {
    teardown();
    initSmoothScroll();
    initReveal();
    initImageLoading();
    initSkeletonSweep();
    void initParallax();
  }

  // astro:page-load chạy cả lần tải đầu và sau mỗi lần điều hướng View Transitions.
  document.addEventListener('astro:page-load', boot);
  document.addEventListener('astro:before-swap', teardown);

  // Đổi cài đặt reduced-motion giữa phiên thì áp dụng ngay, không cần reload.
  reduced.addEventListener('change', boot);
</script>
